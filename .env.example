# Ambiente de execução: development | production
APP_ENV=development

# Tamanho máximo permitido para upload de ZIP (em MB)
MAX_ZIP_SIZE_MB=50

# Caminho absoluto do diretório temporário de extração
# Deixe vazio para usar o default do sistema (/tmp/depcheck)
TEMP_DIR=

# Nível de log: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
